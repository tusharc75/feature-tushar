    "start": "react-scripts start",
    "dev": "yarn install && react-scripts start",
    "build": "react-scripts --max_old_space_size=4096 build",
    "winBuild": "set \"GENERATE_SOURCEMAP=false\" && react-scripts --max_old_space_size=4096 build",
    "sourceMapBuild": "react-scripts --max_old_space_size=4096 build",
    "postbuild": "node uploadSourcemaps.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "commit": "cz",
    "release": "standard-version",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "last 5 safari version",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
