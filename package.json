  "scripts": {
    "prebuild": "node -r dotenv/config src/prebuild/prebuild.js",
    "start": "sass-migrator division **/*.scss && node --max_old_space_size=4096 ./node_modules/vite/bin/vite",
    "dev": "yarn install && sass-migrator division **/*.scss && node --max_old_space_size=4096 ./node_modules/vite/bin/vite",
    "pdev": "pnpm install && sass-migrator division **/*.scss && node --max_old_space_size=4096 ./node_modules/vite/bin/vite",
    "dev:prebuild": "yarn prebuild && yarn dev",
    "dev-https": "set \"HTTPS=true\" && yarn install && vite",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite build --mode production",
    "winBuild": "set \"GENERATE_SOURCEMAP=true\" && node --max_old_space_size=10240 ./node_modules/vite/bin/vite build",
    "sourceMapBuild": "node --max_old_space_size=4096 ./node_modules/vite/bin/vite build",
    "test": "vite test",
    "commit": "cz",
    "ca": "git add . && npm run commit",
    "release": "standard-version",
    "prepare": "husky install",
    "analyze": "yarn winBuild && source-map-explorer 'build/static/js/*.js'",
    "serve": "node --max_old_space_size=4096 ./node_modules/vite/bin/vite build",
    "preview": "vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "last 5 safari version",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
