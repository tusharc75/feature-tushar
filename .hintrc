{
  "extends": [
    "development"
  ],
  "hints": {
    "no-inline-styles": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "position: sticky",
          "background-clip",
          "scroll-behavior",
          "min-height: auto",
          "margin-block",
          "padding-block",
          "padding-inline",
          "inset",
          "margin-inline"
        ]
      }
    ],
    "axe/parsing": [
      "default",
      {
        "duplicate-id-aria": "off"
      }
    ],
    "axe/text-alternatives": [
      "default",
      {
        "image-alt": "off"
      }
    ],
    "typescript-config/strict": "off"
  }
}